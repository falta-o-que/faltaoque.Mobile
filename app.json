{
  "expo": {
    "name": "FaltaOQueFront",
    "slug": "FaltaOQueFront",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.faltaoque.front"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o FaltaOquê use a câmera para ler o QR Code da nota fiscal.",
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
