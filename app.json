{
  "expo": {
    "name": "FaltaOquê?",
    "description": "Organize a despensa, acompanhe produtos e planeje as compras da casa.",
    "slug": "FaltaOQueFront",
    "version": "1.0.0",
    "primaryColor": "#00DD00",
    "orientation": "portrait",
    "icon": "./src/assets/branding/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR",
          "en",
          "es"
        ]
      }
    },
    "locales": {
      "pt-BR": "./src/localization/native/pt-BR.json",
      "en": "./src/localization/native/en.json",
      "es": "./src/localization/native/es.json"
    },
    "android": {
      "icon": "./src/assets/branding/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/branding/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.faltaoque.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o FaltaOquê use a câmera para ler o QR Code da nota fiscal.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "f19e401e-2ee1-41b0-a9a9-dadd61f8a60b"
      }
    }
  }
}
