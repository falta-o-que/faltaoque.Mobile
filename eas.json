{
  "cli": {
    "version": ">= 24.3.0"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "production"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "demo": {
      "channel": "demo",
      "environment": "production",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "demo"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
